node_modules/
dist/
.astro/
.vercel/
.env
.env.local
.DS_Store
*.log

# Raw video masters (keep only compressed .mp4 in git).
# No *.MP4 rule here: git's ignorecase is on for macOS checkouts, so it would
# also match the compressed *.mp4 files we do want tracked. Masters are covered
# by the .MOV and _ORIG rules instead.
public/photos/videos/*.MOV
public/photos/videos/*_ORIG.*

# Kaelo demo app has its own build
kaelo-app/frontend/node_modules/
kaelo-app/frontend/dist/
kaelo-app/**/__pycache__/
kaelo-app/**/*.db
public/kaelo-app/
