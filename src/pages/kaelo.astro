---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ScrollReveal from '@/components/ScrollReveal.astro';

const stats = [
  { n: '619', label: 'health facilities' },
  { n: '2.4M', label: 'people' },
  { n: '18', label: 'health districts' },
];

// The app is a separate service; it only appears once an API is configured.
const kaeloApiUrl = import.meta.env.PUBLIC_KAELO_API_URL;

const team = [
  { group: 'Princeton ORFE', people: ['Dr. Bartolomeo Stellato (advisor)'] },
  { group: 'ACHAP', people: ['Mr. Lesego Busang', 'Mr. Stanley Mapiki', 'Mr. Tiro Molefe', 'Dr. Khumo Seipone'] },
  { group: 'In collaboration with', people: ['Ministry of Health, Botswana', 'Central Medical Stores'] },
];
---

<BaseLayout title="Kaelo | Elliot S. Lee" description="Kaelo, an antimicrobial supply chain optimization platform developed in collaboration with ACHAP and Botswana's Ministry of Health and Central Medical Stores.">
  <!-- Background decoration -->
  <div class="kaelo-bg" aria-hidden="true">
    <svg class="caduceus" viewBox="0 0 100 400" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
      <defs>
        <linearGradient id="rodGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0%" stop-color="currentColor" stop-opacity="0.35" />
          <stop offset="100%" stop-color="currentColor" stop-opacity="0.05" />
        </linearGradient>
      </defs>
      <!-- Rod -->
      <line x1="50" y1="10" x2="50" y2="390" stroke="url(#rodGrad)" stroke-width="1.5" />
      <!-- Serpent (two interlaced sinusoidal curves) -->
      <path d="M50,30 C20,60 80,90 50,120 C20,150 80,180 50,210 C20,240 80,270 50,300 C20,330 80,360 50,390"
            fill="none" stroke="url(#rodGrad)" stroke-width="1.2" />
      <path d="M50,30 C80,60 20,90 50,120 C80,150 20,180 50,210 C80,240 20,270 50,300 C80,330 20,360 50,390"
            fill="none" stroke="url(#rodGrad)" stroke-width="1.2" />
      <!-- Wings hint at top -->
      <path d="M20,20 Q40,30 50,25 Q60,30 80,20" fill="none" stroke="url(#rodGrad)" stroke-width="1" />
    </svg>
  </div>

  <section class="relative max-w-4xl mx-auto px-6 pt-20 pb-12 text-center">
    <ScrollReveal>
      <h1 class="font-serif font-bold text-5xl md:text-7xl mb-5">Kaelo</h1>
      <p class="font-sans text-sm md:text-base opacity-70">
        <span class="font-mono">/ka.ˈe.lo/</span>
        <span class="mx-2 opacity-50">·</span>
        <em>Setswana</em>
        <span class="mx-2 opacity-50">·</span>
        "to care for, to nurture, to look after"
      </p>
      <div class="mx-auto mt-10 mb-12 h-px w-24 bg-gradient-to-r from-transparent via-[color:var(--color-accent)] to-transparent"></div>
    </ScrollReveal>

    <ScrollReveal delay={120}>
      <p class="font-serif text-lg md:text-xl leading-relaxed max-w-2xl mx-auto opacity-95">
        Botswana imports nearly all of its medicines. Getting them from a port to a patient in a rural
        clinic, on time and unexpired, is a logistics problem before it is a clinical one.
      </p>
      <p class="font-serif text-lg md:text-xl leading-relaxed max-w-2xl mx-auto mt-4 text-[color:var(--color-accent)]">
        Kaelo exists to help close that gap.
      </p>
      <p class="font-serif text-base md:text-lg max-w-2xl mx-auto mt-5 opacity-70">
        How a tool like this gets built matters as much as whether it works, so we have written down
        where we stand: <a href="#parachute-research">a note on parachute research</a>.
      </p>
    </ScrollReveal>
  </section>

  <!-- Stats row -->
  <section class="relative max-w-4xl mx-auto px-6 py-10">
    <div class="grid grid-cols-3 gap-4 md:gap-8">
      {stats.map((s, i) => (
        <ScrollReveal delay={i * 100}>
          <div class="text-center py-6">
            <div class="font-serif font-bold text-4xl md:text-5xl">{s.n}</div>
            <div class="font-sans text-xs md:text-sm opacity-60 uppercase tracking-[0.15em] mt-2">{s.label}</div>
          </div>
        </ScrollReveal>
      ))}
    </div>
  </section>

  <!-- August 2025 -->
  <section class="relative max-w-3xl mx-auto px-6 py-12">
    <ScrollReveal>
      <p class="font-sans text-xs uppercase tracking-[0.2em] opacity-55 mb-3">25 August 2025</p>
      <h2 class="font-serif font-bold text-3xl mb-6">The emergency, and what came after</h2>
      <div class="space-y-5 font-serif text-[1.05rem] leading-relaxed opacity-90">
        <p>
          Botswana declared a public health emergency. Facilities had run short of medicines for
          hypertension, diabetes, tuberculosis and cancer, and of things as ordinary as sutures and
          dressings. The causes were structural rather than clinical: a downturn in diamond revenue,
          steep cuts to foreign aid, and a distribution system with no slack left anywhere in it.
        </p>
        <p>
          What happened next is the part worth remembering. Emergency funding moved within weeks.
          Distribution was reorganized so the most remote facilities were reached first. Pharmacists,
          logisticians and ministry staff worked the problem in real time, in the middle of it,
          without the luxury of a clean dataset or a quiet quarter to think in.
        </p>
        <p>
          A crisis maps a system's weak points with a precision no audit ever achieves. Botswana now
          knows exactly where its supply chain bends, and where it breaks. That knowledge is the most
          valuable thing to come out of a hard year, and nobody intends to waste it.
        </p>
      </div>
      <p class="flare font-serif text-base md:text-lg leading-relaxed mt-8">
        Built with local expertise, so the next shock meets a system
        that already saw it coming.
      </p>
    </ScrollReveal>
  </section>

  <!-- What We Do -->
  <section class="relative max-w-3xl mx-auto px-6 py-12">
    <ScrollReveal>
      <h2 class="font-serif font-bold text-3xl mb-6">What we do</h2>
      <div class="space-y-5 font-serif text-[1.05rem] leading-relaxed opacity-90">
        <p>
          Kaelo is an antimicrobial supply chain optimization platform developed in collaboration with ACHAP
          and Botswana's Ministry of Health and Central Medical Stores.
          It uses advanced mathematical models, including robust optimization and adaptive (affine) decision rules, to
          determine how medicines should be procured, stored, and distributed across the country's 619 health facilities.
        </p>
        <p>
          The system accounts for demand uncertainty, transport constraints, procurement costs, and the
          complex tiered network of warehouses, hospitals, clinics, and health posts that cover 2.4M people
          across 18 health districts.
        </p>
      </div>
    </ScrollReveal>
  </section>

  <!-- How it works -->
  <section class="relative max-w-3xl mx-auto px-6 py-12">
    <ScrollReveal>
      <h2 class="font-serif font-bold text-3xl mb-6">How it works</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="card p-6">
          <h3 class="font-serif font-bold text-xl mb-3">Robust optimization</h3>
          <p class="font-serif opacity-85 leading-relaxed">
            Instead of assuming a single forecast is correct, the model optimizes against the
            <em>worst-case</em> demand scenario within a plausible uncertainty set. Decisions that
            hold up under the hardest month hold up under every month.
          </p>
        </div>
        <div class="card p-6">
          <h3 class="font-serif font-bold text-xl mb-3">Affine decision rules</h3>
          <p class="font-serif opacity-85 leading-relaxed">
            Rather than fixing every order up front, Kaelo learns a linear policy: "order <em>x</em> if
            we've observed demand <em>y</em>." This keeps the math tractable while letting the system
            adapt as real demand unfolds month by month.
          </p>
        </div>
      </div>
    </ScrollReveal>
  </section>

  <!-- Software -->
  <section class="relative max-w-3xl mx-auto px-6 py-12">
    <ScrollReveal>
      <h2 class="font-serif font-bold text-3xl mb-6">Software</h2>
      <div class="card p-6">
        <p class="font-serif opacity-85 leading-relaxed mb-4">
          A public build of the planning tool, with the optimization model intact and every
          procurement figure stripped out. You supply the demand and cost numbers yourself.
        </p>
        {kaeloApiUrl ? (
          <>
            <a href="/kaelo-app/" class="inline-block px-4 py-2 rounded-full bg-[color:var(--color-accent)] text-white font-sans text-sm no-underline hover:opacity-90">
              Open the software &rarr;
            </a>
            <p class="font-sans text-xs opacity-60 mt-3 mb-0">
              Best on a desktop browser for now. The solver sleeps when idle, so the first load can take
              a moment to wake up.
            </p>
          </>
        ) : (
          <p class="font-sans text-sm opacity-60">
            Source at <a href="https://github.com/mistershilai/mistershilai.github.io/tree/main/kaelo-app">kaelo-app</a>.
            The solver runs as a separate service, so the hosted version goes live once its API is deployed.
          </p>
        )}
      </div>
    </ScrollReveal>
  </section>

  <!-- Team -->
  <section class="relative max-w-3xl mx-auto px-6 py-12 pb-24">
    <ScrollReveal>
      <h2 class="font-serif font-bold text-3xl mb-6">Team &amp; collaborators</h2>
      <div class="grid md:grid-cols-3 gap-6 font-sans text-sm">
        {team.map((t) => (
          <div>
            <div class="font-semibold text-[color:var(--color-accent)] mb-2">{t.group}</div>
            <ul class="space-y-1 opacity-85 list-none p-0">
              {t.people.map((p) => <li>{p}</li>)}
            </ul>
          </div>
        ))}
      </div>

      <p class="acknowledgement" id="parachute-research">
        Global health carries a long record of parachute research: arriving from outside, collecting
        what is needed, and leaving little behind. Kaelo is structured against that. The questions are
        set by the institutions that run the supply chain, the data remains theirs, and the software is
        built to be operated locally.
      </p>
    </ScrollReveal>
  </section>
</BaseLayout>

<style>
  .kaelo-bg {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    overflow: hidden;
  }
  .kaelo-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, color-mix(in srgb, currentColor 6%, transparent) 1px, transparent 1px),
      linear-gradient(to bottom, color-mix(in srgb, currentColor 6%, transparent) 1px, transparent 1px);
    background-size: 48px 48px;
    opacity: 0.5;
    mask-image: radial-gradient(ellipse at center, black 40%, transparent 85%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 40%, transparent 85%);
  }
  .caduceus {
    position: absolute;
    right: 4%;
    top: 8%;
    width: clamp(60px, 8vw, 120px);
    height: auto;
    color: var(--color-accent);
    opacity: 0.4;
  }
  @media (max-width: 768px) {
    .caduceus { right: 2%; top: 6%; opacity: 0.25; }
  }
  .font-mono { font-family: ui-monospace, "SF Mono", Menlo, monospace; }

  /* Standing note on research conduct, in the register of an acknowledgement:
     quiet, set apart, not competing with the page. */
  .acknowledgement {
    /* Clears the sticky nav when linked to from the top of the page. */
    scroll-margin-top: 5.5rem;
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    font-family: var(--font-serif);
    font-size: 0.85rem;
    font-style: italic;
    line-height: 1.65;
    opacity: 0.62;
    max-width: 42rem;
  }
  :global(.dark) .acknowledgement { border-top-color: rgba(255, 255, 255, 0.12); }

  /* Closing line of the emergency section. Amber rather than the site accent,
     with a wider and slower sweep than the heading shimmer, so it reads as its
     own aside rather than another section heading. Reuses the global
     `shimmer` keyframes. */
  .flare {
    /* Weight set here rather than via .font-semibold, which the site-wide
       shimmer rule also targets and would repaint blue. */
    font-weight: 600;
    background: linear-gradient(
      90deg,
      #b45309 0%,
      #b45309 30%,
      #f59e0b 45%,
      #fcd34d 50%,
      #f59e0b 55%,
      #b45309 70%,
      #b45309 100%
    );
    background-size: 250% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: shimmer 7s linear infinite;
  }
  :global(.dark) .flare {
    background: linear-gradient(
      90deg,
      #f0b429 0%,
      #f0b429 30%,
      #fcd34d 45%,
      #fef3c7 50%,
      #fcd34d 55%,
      #f0b429 70%,
      #f0b429 100%
    );
    background-size: 250% 100%;
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  @media (prefers-reduced-motion: reduce) {
    .flare { animation: none; }
  }
</style>
