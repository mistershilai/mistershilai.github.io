---
// Click-to-copy grid of email addresses with a shimmer/shine hover effect.
interface EmailEntry {
  label: string;
  address: string;
}

const emails: EmailEntry[] = [
  { label: 'Personal', address: 'mistershilai@gmail.com' },
  { label: 'Institutional', address: 'elliotslee@berkeley.edu' },
  { label: 'Botswana Project', address: 'elliot@achap.org' },
  { label: 'Alumni', address: 'el3205@alumni.princeton.edu' },
];
---

<div class="email-shimmer-grid">
  {emails.map(({ label, address }) => (
    <a
      href={`mailto:${address}`}
      class="email-tile"
      data-email={address}
      aria-label={`${label} email: ${address} — click to copy`}
    >
      <span class="email-tile-shine" aria-hidden="true"></span>
      <span class="email-tile-label">{label}</span>
      <span class="email-tile-address font-semibold">{address}</span>
      <span class="email-tile-copied" aria-hidden="true">Copied ✓</span>
    </a>
  ))}
</div>

<style>
  .email-shimmer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 0.85rem;
  }

  .email-tile {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.9rem 1.1rem;
    border-radius: 0.9rem;
    border: 1px solid rgba(0, 0, 0, 0.1);
    background: rgba(0, 0, 0, 0.02);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }
  .dark .email-tile {
    border-color: rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.03);
  }
  .email-tile:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px -12px rgba(0, 119, 190, 0.4);
  }
  .dark .email-tile:hover {
    box-shadow: 0 8px 20px -12px rgba(74, 163, 217, 0.45);
  }

  .email-tile-label {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.55;
  }

  .email-tile-address {
    font-size: 0.92rem;
    line-height: 1.3;
    word-break: break-all;
  }

  /* Diagonal light sweep on hover — matches the site's shimmer motif. */
  .email-tile-shine {
    position: absolute;
    top: 0;
    left: -60%;
    width: 40%;
    height: 100%;
    background: linear-gradient(115deg, transparent, rgba(255, 255, 255, 0.55), transparent);
    transform: skewX(-18deg);
    pointer-events: none;
    opacity: 0;
  }
  .dark .email-tile-shine {
    background: linear-gradient(115deg, transparent, rgba(255, 255, 255, 0.16), transparent);
  }
  .email-tile:hover .email-tile-shine {
    animation: email-tile-shine 0.9s ease forwards;
  }
  @keyframes email-tile-shine {
    0%   { left: -60%; opacity: 0; }
    15%  { opacity: 1; }
    100% { left: 130%; opacity: 0; }
  }

  .email-tile-copied {
    position: absolute;
    top: 0.55rem;
    right: 0.7rem;
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--color-accent);
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .dark .email-tile-copied {
    color: var(--color-accent-dark);
  }
  .email-tile.copied .email-tile-copied {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .email-tile,
    .email-tile-shine {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  function wireEmailTiles() {
    document.querySelectorAll<HTMLAnchorElement>('.email-tile:not([data-wired])').forEach((tile) => {
      tile.dataset.wired = 'true';
      tile.addEventListener('click', () => {
        const address = tile.dataset.email;
        if (!address || !navigator.clipboard) return;
        // Best-effort copy alongside the default mailto: navigation — never blocks it.
        navigator.clipboard.writeText(address).then(() => {
          tile.classList.add('copied');
          setTimeout(() => tile.classList.remove('copied'), 1600);
        }).catch(() => {});
      });
    });
  }
  wireEmailTiles();
  document.addEventListener('astro:page-load', wireEmailTiles);
</script>
